# ============================================================================
#  Revio environment variables
#  Copy to .env.local for development. Never commit real secrets.
# ============================================================================

# --- Database (Postgres; Supabase / Neon / RDS all work) --------------------
DATABASE_URL="postgresql://user:password@localhost:5432/revio?schema=public"
# Direct (non-pooled) URL — required by Prisma Migrate when using a pooler
DIRECT_URL="postgresql://user:password@localhost:5432/revio?schema=public"

# --- Auth.js / NextAuth -----------------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# --- Stripe (Connect + Payments) --------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Platform fee taken from each rental (basis points; 1000 = 10%)
PLATFORM_FEE_BPS="1000"

# --- Stripe Identity (KYC) --------------------------------------------------
STRIPE_IDENTITY_WEBHOOK_SECRET="whsec_..."

# --- Storage (Supabase Storage or S3) ---------------------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="revio"
# ...or S3
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="Revio <hello@revio.app>"

# --- Google Maps ------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
